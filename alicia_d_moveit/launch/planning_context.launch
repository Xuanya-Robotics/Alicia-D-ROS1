<launch>
  <!-- Robot version argument -->
  <arg name="robot_version" default="v5_6" doc="Robot version: v5_5 or v5_6" />
  
  <!-- Gripper type argument -->
  <arg name="gripper_type" default="100mm" doc="Gripper type: 50mm or 100mm" />

  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>
  <!-- Control whether to load SRDF from file -->
  <arg name="load_robot_semantic" default="true"/>

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>

  <!-- URDF file path -->
  <arg name="urdf_file" default="$(find alicia_d_descriptions)/urdf/Alicia_D_$(arg robot_version)/Alicia_D_gripper_$(arg gripper_type).urdf" />
  
  <!-- SRDF file path -->
  <arg name="srdf_file" default="$(find alicia_d_moveit)/config/Alicia_D_$(arg robot_version)_gripper_$(arg gripper_type).srdf" />

  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)" textfile="$(arg urdf_file)"/>

  <!-- The semantic description that corresponds to the URDF -->
  <param if="$(arg load_robot_semantic)" name="$(arg robot_description)_semantic" textfile="$(arg srdf_file)" />

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <rosparam command="load" file="$(find alicia_d_moveit)/config/joint_limits.yaml"/>
    <rosparam command="load" file="$(find alicia_d_moveit)/config/cartesian_limits.yaml"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(find alicia_d_moveit)/config/kinematics.yaml"/>

  </group>

</launch>
