<launch>
  <!-- "camera" allows universally-named topics to be republished to
       the corresponding "real" camera topics -->
  <arg name="camera_link_selector" default="camera_rgb_optical_frame" />
  <arg name="camera_name" default="camera" />
  
  <!-- sensor_manager gets the robot name from parameter server -->
  <arg name="moveit_sensor_manager" default="Alicia_D_v5_6_gripper_100mm" />
  
  <include if="$(eval arg('moveit_sensor_manager') == 'Alicia_D_v5_6_gripper_100mm')"
           file="$(find alicia_d_moveit)/launch/Alicia_D_v5_6_gripper_100mm_moveit_sensor_manager.launch.xml" />
  <include if="$(eval arg('moveit_sensor_manager') == 'Alicia_D_v5_6_gripper_50mm')"
           file="$(find alicia_d_moveit)/launch/Alicia_D_v5_6_gripper_50mm_moveit_sensor_manager.launch.xml" />
  <include if="$(eval arg('moveit_sensor_manager') == 'Alicia_D_v5_5_gripper_100mm')"
           file="$(find alicia_d_moveit)/launch/Alicia_D_v5_5_gripper_100mm_moveit_sensor_manager.launch.xml" />
</launch>
