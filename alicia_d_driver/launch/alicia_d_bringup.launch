<launch>
  <!--
  ===================================================================================
  |      Main Bringup Launch File for the Alicia-D Robot with MoveIt!              |
  ===================================================================================
  -->
  <!-- Choose MoveIt controller manager: fake | simple | ros_control -->
  <arg name="moveit_controller_manager" default="ros_control"/>
  <arg name="port" default="/dev/ttyUSB0" />
  <arg name="baudrate" default="1000000" />
  <arg name="firmware_version" default="auto" />
  <!-- Robot version: v5_5 or v5_6. Default v5_6 supports both 50mm and 100mm grippers -->
  <arg name="robot_version" default="v5_6" />
  <arg name="gripper_type" default="100mm" />
  <!-- Defer URDF loading; driver will publish robot_description after firmware detection -->

  <!-- Load the ROS controllers configuration -->
  <rosparam file="$(find alicia_d_driver)/config/controllers.yaml" command="load" />
  
  <!-- Load the MoveIt controller connection file -->
  <rosparam file="$(find alicia_d_moveit)/config/ros_controllers.yaml"/>

  <!-- =================================================================================== -->
  <!-- |                       START THE HARDWARE AND ROS_CONTROL                          | -->
  <!-- =================================================================================== -->

  <node name="alicia_d_driver_node" pkg="alicia_d_driver" type="alicia_d_driver_node" output="screen">
    
      <!-- Serial Port Configuration -->
      <param name="port"           type="string" value="$(arg port)"/>
      <param name="baud_rate"      type="int"    value="$(arg baudrate)"/>
      
      <!-- Firmware Version Configuration -->
      <param name="firmware_version" type="string" value="$(arg firmware_version)"/>
      
      <!-- Gripper Type Configuration -->
      <param name="gripper_type" type="string" value="$(arg gripper_type)"/>
      
      <!-- Driver Behavior Configuration -->
      <param name="debug_mode"     type="bool"   value="false"/>
      <param name="rate_limit_sec" type="double" value="0.01"/>
      <!-- Let the driver load robot_description after firmware detection -->
      <param name="load_robot_description" type="bool" value="true"/>
      
      <!-- Speed Control for V6+ firmware -->
      <param name="default_speed_rad_s" type="double" value="0.349"/>  <!-- ~20 deg/s default -->
        <!-- Command streaming and smoothing -->
        <param name="command_rate_hz"           type="double" value="100.0"/>  <!-- Reduced for efficiency -->
        <param name="use_trajectory_smoothing"  type="bool"   value="true"/>
        <param name="max_joint_velocity_rad_s"  type="double" value="5.0"/>  <!-- Increased for better responsiveness -->
        <param name="max_joint_accel_rad_s2"    type="double" value="20.0"/>  <!-- Increased for better responsiveness -->
        <param name="max_gripper_velocity_rad_s" type="double" value="3.0"/>  <!-- Increased for better responsiveness -->
        <param name="max_gripper_accel_rad_s2"   type="double" value="20.0"/>  <!-- Increased for better responsiveness -->
        <param name="gripper_input_is_percent"  type="bool"   value="false"/>
  </node>



  <!-- Load the joint names for the hardware interface -->
  <rosparam file="$(find alicia_d_driver)/config/joint_names.yaml" command="load" />
  
  <!-- Start the ros_control hardware interface node -->
  <node name="alicia_d_hw_interface" pkg="alicia_d_driver" type="alicia_d_hw_interface_node" output="screen"/>

  <!-- Load the robot state publisher. Waits for robot_description via launch-prefix delay -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen" launch-prefix="bash -c 'sleep 2; $0 $@' "/>

  <!-- Load the controller spawner in the global namespace -->
  <!-- Only spawn trajectory controllers. The driver already publishes /joint_states. -->
  <!-- Delay to ensure robot_description is loaded first -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" args="
      Alicia_controller
      Gripper_controller
    " launch-prefix="bash -c 'sleep 2; $0 $@' "/>

  <!-- =================================================================================== -->
  <!-- |                                  START MOVEIT!                                  | -->
  <!-- =================================================================================== -->
  
  <!-- Broadcast static tf for world frame (match demo.launch) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="virtual_joint_broadcaster_0" args="0 0 0 0 0 0 world base_link" />

  <!-- Run the main MoveIt! planning execution context -->
  <!-- Note: move_group has respawn="true" so initial failures are handled gracefully -->
  <include file="$(find alicia_d_moveit)/launch/move_group.launch">
    <arg name="load_robot_description" value="false"/>
    <arg name="robot_version" value="$(arg robot_version)"/>
    <arg name="gripper_type" value="$(arg gripper_type)"/>
    <!-- Pass controller manager selection as arg -->
    <arg name="moveit_controller_manager" value="$(arg moveit_controller_manager)" />
  </include>

  <!-- =================================================================================== -->
  <!-- |                                 START VISUALIZATION                             | -->
  <!-- =================================================================================== -->

  <!-- Run RViz and load the default config to see the state of the move_group node -->
  <include file="$(find alicia_d_moveit)/launch/moveit_rviz.launch">
    <arg name="rviz_config" value="$(find alicia_d_moveit)/launch/moveit.rviz"/>
  </include>

</launch>