<launch>
  <!-- Serial port for robot connection (e.g., /dev/ttyUSB0, /dev/ttyACM0).
       Leave empty to let the driver auto-detect a suitable port. -->
  <arg name="port" default="" />

  <!-- Default joint speed in degrees per second (4.39–439.45).
       This is forwarded to the driver as 'default_speed_deg_s'. -->
  <arg name="default_speed_deg_s" default="20.0" />

  <node name="alicia_d_driver_node"
        pkg="alicia_d_driver"
        type="alicia_d_driver_node"
        output="screen">

    <!-- Serial port configuration -->
    <param name="port" type="string" value="$(arg port)" />

    <!-- Driver speed configuration (deg/s) -->
    <param name="default_speed_deg_s" type="double" value="$(arg default_speed_deg_s)" />

  </node>
</launch>
